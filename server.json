{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.AlbertPa00/switch402-mcp",
  "description": "x402 P2P grid: keyless LLM inference, web search & Base token safety reports",
  "version": "0.1.3",
  "title": "Switch402",
  "websiteUrl": "https://switch402.fly.dev",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "switch402-mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SWITCH402_URL",
          "description": "Switch402 grid server base URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "https://switch402.fly.dev"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://switch402.fly.dev/mcp"
    }
  ]
}
